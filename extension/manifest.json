{
  "manifest_version": 3,
  "name": "Capture Studio",
  "version": "1.3.3",
  "description": "Capture the visible tab, full scrolling page, or selected area directly into an editor. Record screen and camera locally.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "offscreen",
    "tabCapture",
    "desktopCapture"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "assets/js/background.js"
  },
  "minimum_chrome_version": "116"
}
